# Copia este archivo como .env y pon tu clave real. NUNCA subas el .env a GitHub.
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_aqui_tu_clave

# Modelos (opcional). Si Google retira alguno, cámbialo aquí.
MODELO_TEXTO=gemini-3.5-flash
# Se usa si el principal está saturado (error 503)
MODELO_RESPALDO=gemini-3.1-flash-lite
MODELO_IMAGEN=gemini-3.1-flash-image

# 1 = generar imágenes en el modo B; 0 = sin imágenes
GENERAR_IMAGENES=1

# Imágenes GRATIS con Cloudflare Workers AI (el nivel gratuito de Gemini no incluye imágenes).
# Si completas estos dos datos, las imágenes se generan con Cloudflare; si los dejas vacíos, con Gemini.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 1 = Holmes puede consultar su índice MCP con los libros; 0 = desactivado
USAR_MCP=1

# Protección de gastos en la demo pública
MAX_MENSAJES_POR_SESION=80

# Zona horaria usada para las deducciones de Holmes sobre la hora
ZONA_HORARIA=America/Santiago
